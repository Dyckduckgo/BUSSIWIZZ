# Groq API Key (Get a free API key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model configuration
# Default for Groq's built-in web search tool: openai/gpt-oss-120b
# Alternative models: openai/gpt-oss-20b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
 
# Optional: SEC EDGAR User-Agent (Format: AppName AdminContact@domain.com)
SEC_EDGAR_USER_AGENT=StockResearchAgent/1.0 (research@busswizz-finance.local)
